{
	"format_version": "1.21.0",
	"minecraft:block": {
		"description": {
			"identifier": "sag:fluid_pipe",
			"menu_category": {
				"category": "construction"
			},
			"traits": {
				"minecraft:placement_direction": {
					"enabled_states": [
						"minecraft:facing_direction"
					]
				}
			}
		},
		"components": {
			"minecraft:loot": "loot_tables/blocks/fluid_pipe.json",
			"minecraft:destructible_by_explosion": true,
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 3
			},
			"minecraft:material_instances": {
				"*": {
					"texture": "sag_fluid_pipe",
					"render_method": "opaque"
				}
			},
			"minecraft:geometry": "geometry.sag.fluid_pipe_f_f"
		},
		"permutations": [
			{
				"condition": "query.block_state('minecraft:facing_direction') == 'east'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							0,
							-90,
							0
						]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:facing_direction') == 'south'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							0,
							180,
							0
						]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:facing_direction') == 'west'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							0,
							90,
							0
						]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:facing_direction') == 'up'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							-90,
							0,
							0
						]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:facing_direction') == 'down'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							90,
							0,
							0
						]
					}
				}
			}
		]
	}
}